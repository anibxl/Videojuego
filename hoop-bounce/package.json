{
  "name": "hoop-bounce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HoopBounce, par EchoSpeed : un jeu de plateforme où l'on fait rebondir un ballon de basket jusqu'au panier.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node tools/build-web.mjs",
    "android:sync": "node tools/build-web.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "android:test-apk": "node tools/build-test-apk.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
