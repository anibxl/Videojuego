<?xml version="1.0" encoding="utf-8"?>
<!--
  Version de TEST de Hoop Bounce (APK à installer à la main, pour soi et des amis testeurs).
  Identifiant distinct de la version Play Store (com.echospeed.hoopbounce) : les deux peuvent
  coexister sur un même téléphone. Aucune permission Internet : le jeu tourne entièrement hors ligne,
  et les publicités sont les annonces de TEST simulées du jeu.
  Les versions (versionCode, versionName, minSdk, targetSdk) sont fixées par tools/build-test-apk.mjs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.echospeed.hoopbounce.test">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
