; Engine configuration file.
; CLEAN RUSH — Clean it. Upgrade it. Unlock everything.

config_version=5

[application]

config/name="Clean Rush"
config/description="Clean it. Upgrade it. Unlock everything."
config/version="1.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.18, 0.4, 1)
boot_splash/image="res://assets/icons/ui/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/autoload/data.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=20.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cleanable"
3d_physics/layer_3="player"
3d_physics/layer_4="player_blocker"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.95, 1)
